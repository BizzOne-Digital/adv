# =============================================================================
# CAFBEX environment variables
# Copy to .env.local for local development
# =============================================================================

# MongoDB — use Atlas URI in production so uploads persist across Vercel deploys
# Local Compass example: mongodb://127.0.0.1:27017/cafbex
MONGODB_URI=mongodb://127.0.0.1:27017/cafbex

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth / Auth.js
AUTH_SECRET=generate-a-long-random-string-here
AUTH_URL=http://localhost:3000
# NEXTAUTH_URL is accepted as a fallback by some helpers
NEXTAUTH_URL=http://localhost:3000

# Admin seed credentials (used by npm run seed)
ADMIN_EMAIL=admin@cafbex.org
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_NAME=CAFBEX Admin

# -----------------------------------------------------------------------------
# Email — Hostinger SMTP (preferred)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=farm@cafbex.ca
SMTP_PASSWORD=your-mailbox-password
EMAIL_FROM=CAFBEX <farm@cafbex.ca>
CONTACT_TO=farm@cafbex.ca
BOOKING_TO=farm@cafbex.ca
CONTACT_RECIPIENT_EMAIL=farm@cafbex.ca

# Optional fallback if SMTP is not set
RESEND_API_KEY=

# Cloudinary optional (not required — uploads use MongoDB / public/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
