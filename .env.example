# =============================================================================
# CAFBEX environment variables
# Copy to .env.local for local development
# =============================================================================

# MongoDB — use Atlas URI in production so uploads persist across Vercel deploys
# Local Compass example: mongodb://127.0.0.1:27017/cafbex
MONGODB_URI=mongodb://127.0.0.1:27017/cafbex

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth / Auth.js
AUTH_SECRET=generate-a-long-random-string-here
AUTH_URL=http://localhost:3000
# NEXTAUTH_URL is accepted as a fallback by some helpers
NEXTAUTH_URL=http://localhost:3000

# Admin seed credentials (used by npm run seed)
ADMIN_EMAIL=admin@cafbex.org
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_NAME=CAFBEX Admin

# Cloudinary (leave blank locally until configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend email (leave blank locally until configured)
RESEND_API_KEY=
EMAIL_FROM=CAFBEX <onboarding@resend.dev>
CONTACT_TO=
BOOKING_TO=

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
